# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Enable only after configuring Google in Supabase Authentication > Providers.
# See supabase/passwordless-auth-setup.md for email OTP and Google setup.
VITE_GOOGLE_AUTH_ENABLED=false

# Cloudflare Turnstile (bot protection for sign-in, sign-up and password reset).
# Public SITE key from Cloudflare > Turnstile. The SECRET key goes only in
# Supabase > Authentication > Attack Protection, never in this file.
# Leave empty to disable. Deploy with this set BEFORE enabling CAPTCHA in Supabase.
VITE_TURNSTILE_SITE_KEY=

# Paystack
VITE_PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# Analytics & Monitoring
# PostHog project (public) key. Host must match the project's region:
# https://eu.i.posthog.com for EU Cloud, https://us.i.posthog.com for US Cloud.
VITE_POSTHOG_KEY=your_posthog_project_key
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_SENTRY_DSN=your_sentry_dsn

# Auth.js
AUTH_SECRET=your_auth_secret
NEXTAUTH_URL=http://localhost:3000

# ImageKit (Media Library editing: crop, resize, background removal).
# URL endpoint from your ImageKit dashboard, e.g. https://ik.imagekit.io/kadesh.
#
# In the dashboard add an External Storage origin of type "Web proxy" (no base
# URL needed). ImageKit then fetches the full Supabase storage URL on demand,
# so images stay in Supabase and nothing is synced/imported.
VITE_IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint
